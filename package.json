{
  "name": "contacerta",
  "version": "3.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node ferramentas/servidor.mjs 5173",
    "test": "node --test testes/",
    "versao": "node ferramentas/gerarVersao.mjs",
    "www": "npm run versao && node ferramentas/prepararWww.mjs",
    "android:sync": "npm run www && cap sync android",
    "apk": "npm run android:sync && node ferramentas/gerarApk.mjs",
    "ios:sync": "npm run www && cap sync ios && node ferramentas/sincronizarVersaoIos.mjs",
    "publicar-atualizacao": "npm run www && node ferramentas/publicarAtualizacao.mjs"
  },
  "contacerta": {
    "versaoMinimaDoApk": "3.1.0"
  },
  "dependencies": {
    "@capacitor/android": "7.4.4",
    "@capacitor/core": "7.4.4",
    "@capacitor/ios": "7.4.4",
    "@capacitor/local-notifications": "7.0.7",
    "@capgo/capacitor-updater": "7.53.0"
  },
  "devDependencies": {
    "@capacitor/cli": "7.4.4",
    "happy-dom": "21.0.4"
  }
}
